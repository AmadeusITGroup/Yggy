# Environment variables for the AUD API microservice.
# Copy this file to .env.local and fill in the values.
# Please do not rename these variables.
#
# The identity below is an Entra ID (Azure AD) application registration; see
# https://learn.microsoft.com/entra/identity-platform/quickstart-register-app

# Identity used by the AUD API microservice to access different other services
# /!\ Please do not rename these variables /!\
AZURE_TENANT_ID='xxx'
AZURE_CLIENT_ID='yyy'
AZURE_CLIENT_SECRET=<Azure AD app client secret>

# Azure Storage Blob endpoint storing the different AUD data
# Usually the format is: https://<storage-account-name>.blob.core.windows.net/
AZURE_STORAGE_BLOB_ENDPOINT=<Azure Storage Blob endpoint>

AUD_API_SWAGGER_UI_OAUTH_CLIENT_ID=<Client ID for swagger resource>
AUD_API_SWAGGER_UI_OAUTH_APP_NAME=<Name for swagger resource>