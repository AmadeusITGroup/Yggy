<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hibernate Validator configuration.

  The constraint-mapping overrides the @Valid on getMetadata() in V1BaseInstance
  and V1BaseConfig. Both subclasses inherit @Valid from V1Base#getMetadata() and
  also declare it themselves (generated by openapi-generator with useBeanValidation=true).
  Hibernate Validator 9 forbids @Valid being declared more than once in the same
  method hierarchy (HV000131). The mapping below disables cascaded validation on
  the overriding methods so the constraint remains effective via the parent only.
-->
<validation-config
    xmlns="https://jakarta.ee/xml/ns/validation/configuration"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/validation/configuration
        https://jakarta.ee/xml/ns/validation/validation-configuration-3.0.xsd"
    version="3.0">
  <constraint-mapping>META-INF/v1base-validation-override.xml</constraint-mapping>
</validation-config>
