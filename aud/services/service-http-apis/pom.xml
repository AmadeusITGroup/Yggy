<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.amadeus.aud</groupId>
    <artifactId>services</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <groupId>com.amadeus.aud.services</groupId>
  <artifactId>service-http-apis</artifactId>
  <inceptionYear>2024</inceptionYear>

  <properties>
    <unittests.instruction.coverage>0.80</unittests.instruction.coverage>
    <unittests.branch.coverage>0.72</unittests.branch.coverage>

    <jvm.args>-XX:+UseG1GC
      -XX:+UseDynamicNumberOfGCThreads
      -XX:+UseStringDeduplication
      -XX:InitialRAMPercentage=50
      -XX:MaxRAMPercentage=50
      -XX:+AlwaysPreTouch
        --add-opens java.base/java.lang=ALL-UNNAMED</jvm.args>
    <runOnlyGroups/>
    <!-- Read by the Quarkus build, which writes openapi.json/yaml there; checked by EndpointInventoryIT -->
    <quarkus.smallrye-openapi.store-schema-directory>${project.build.directory}/openapi</quarkus.smallrye-openapi.store-schema-directory>
  </properties>

  <dependencies>
    <!--        Quarkus-->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-client-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-openapi</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-fault-tolerance</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-oidc</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-oidc-client</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-client-oidc-filter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-vertx</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-opentelemetry</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-extension-trace-propagators</artifactId>
    </dependency>
    <dependency>
      <groupId>io.smallrye</groupId>
      <artifactId>smallrye-jwt-build</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-scheduler</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-graphql</artifactId>
    </dependency>
    <!-- Do no activate hibernate validation until all scopes have valid data
    Because the checker relies on hibernate validation of the fields from librairy-yaml-model
-->
    <!--    <dependency>-->
    <!--      <groupId>io.quarkus</groupId>-->
    <!--      <artifactId>quarkus-hibernate-validator</artifactId>-->
    <!--    </dependency>-->

    <!--        SmallRye-->
    <dependency>
      <groupId>io.smallrye.reactive</groupId>
      <artifactId>smallrye-mutiny-vertx-web-client</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <scope>test</scope>
    </dependency>

    <!--        Google-->
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
    </dependency>

    <!--        Apache Commons-->
    <dependency>
      <groupId>commons-net</groupId>
      <artifactId>commons-net</artifactId>
    </dependency>

    <!--        Logs-->
    <dependency>
      <groupId>org.jboss.slf4j</groupId>
      <artifactId>slf4j-jboss-logmanager</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-logging-json</artifactId>
    </dependency>

    <!--        Microsoft-->
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-identity</artifactId>
    </dependency>

    <dependency>
      <groupId>com.amadeus.aud.libraries</groupId>
      <artifactId>lib-yaml-model</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.amadeus.aud.libraries</groupId>
      <artifactId>lib-data-engine-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.amadeus.aud.libraries</groupId>
      <artifactId>lib-data-engine</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.amadeus.aud.libraries</groupId>
      <artifactId>lib-graph-engine-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.amadeus.aud.libraries</groupId>
      <artifactId>lib-graph-engine</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.amadeus.aud.libraries</groupId>
      <artifactId>lib-backend-apis</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.amadeus.aud.libraries</groupId>
      <artifactId>lib-aud-service</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.amadeus.aud.libraries</groupId>
      <artifactId>lib-v2-objects-service</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Jandex-indexed HTTP modules, only discovered by Quarkus at runtime -->
    <dependency>
      <groupId>com.amadeus.aud.services</groupId>
      <artifactId>service-azure-nsg-http</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.amadeus.aud.services</groupId>
      <artifactId>service-ip-report-http</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.amadeus.aud.services</groupId>
      <artifactId>service-aud-open-http</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.amadeus.aud.services</groupId>
      <artifactId>service-v2-objects-http</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- Jandex index needed so that Quarkus discovers the http service as well -->
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
        <version>${jandex-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>make-index</id>
            <goals>
              <goal>jandex</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!--
          EndpointInventoryIT compares the OpenAPI schema written by the Quarkus build
          (see quarkus.smallrye-openapi.store-schema-directory) with its EXPECTED_ENDPOINTS list.
        -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
            <configuration>
              <systemPropertyVariables>
                <openapi.schema.file>${quarkus.smallrye-openapi.store-schema-directory}/openapi.json</openapi.schema.file>
              </systemPropertyVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
