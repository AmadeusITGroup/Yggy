<?xml version="1.0" encoding="UTF-8"?>
<project>
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.amadeus.aud</groupId>
    <artifactId>clis</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <groupId>com.amadeus.aud.clis</groupId>
  <artifactId>cli-simple-checker</artifactId>
  <inceptionYear>2025</inceptionYear>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <unittests.instruction.coverage>0.0</unittests.instruction.coverage>
    <unittests.branch.coverage>0.0</unittests.branch.coverage>

    <annotations.version>4.10.5</annotations.version>
    <expressly.version>6.0.0</expressly.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.spotbugs</groupId>
      <artifactId>spotbugs-annotations</artifactId>
      <version>${annotations.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.amadeus.aud.libraries</groupId>
      <artifactId>lib-checker-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.amadeus.aud.libraries</groupId>
      <artifactId>lib-checker</artifactId>
      <version>${project.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.amadeus.aud.libraries</groupId>
      <artifactId>lib-data-engine</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.amadeus.aud.libraries</groupId>
      <artifactId>lib-graph-engine</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.amadeus.aud.libraries</groupId>
      <artifactId>lib-file-checks</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.amadeus.aud.libraries</groupId>
      <artifactId>lib-domain-checks</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.glassfish.expressly</groupId>
      <artifactId>expressly</artifactId>
      <version>${expressly.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
