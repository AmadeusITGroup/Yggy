<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.amadeus.aud</groupId>
  <artifactId>parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <inceptionYear>2024</inceptionYear>

  <modules>
    <module>clis</module>
    <module>libraries</module>
    <module>services</module>
  </modules>

  <properties>
    <project.build.outputTimestamp>1970-01-01T00:00:00Z</project.build.outputTimestamp>
    <maven.compiler.release>25</maven.compiler.release>
    <maven.compiler.failOnWarning>true</maven.compiler.failOnWarning>
    <unittests.instruction.coverage>0.80</unittests.instruction.coverage>
    <unittests.branch.coverage>0.80</unittests.branch.coverage>
    <quarkus.config-tracking.enabled>true</quarkus.config-tracking.enabled>
    <!--
      Default per-test-method timeout (see maven-surefire-plugin below). This is a
      guard against a genuinely hung test, NOT an assertion about how fast a test
      should be: tests run concurrently, both across modules (-T1C in
      .mvn/maven.config) and within a module, so wall-clock time per method depends
      on machine load. A tight bound here fails healthy tests on a busy machine.
    -->
    <junit.timeout>60 s</junit.timeout>

    <assertj-core.version>3.27.7</assertj-core.version>
    <azure-identity.version>1.18.7</azure-identity.version>
    <commons-net.version>3.13.0</commons-net.version>
    <download-maven-plugin.version>1.9.0</download-maven-plugin.version>
    <guava.version>33.7.2-jre</guava.version>
    <google.failureaccess.version>1.0.3</google.failureaccess.version>
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    <jakarta.annotation-api.version>3.0.0</jakarta.annotation-api.version>
    <jakarta.inject-api.version>2.0.1</jakarta.inject-api.version>
    <jakarta.validation-api.version>3.1.1</jakarta.validation-api.version>
    <junit.version>6.1.3</junit.version>
    <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
    <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
    <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-release-plugin.version>3.3.1</maven-release-plugin.version>
    <maven-site-plugin.version>3.22.0</maven-site-plugin.version>
    <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <mockito.version>5.24.0</mockito.version>
    <jackson-annotations.version>2.22</jackson-annotations.version>
    <jackson-datatype.version>2.22.4</jackson-datatype.version>
    <jandex-maven-plugin.version>3.6.0</jandex-maven-plugin.version>
    <osgi-annotation-bundle.version>2.0.0</osgi-annotation-bundle.version>

    <!-- Stay on Quarkus LTS if possible -->
    <quarkus.version>3.40.1.1</quarkus.version>
    <quarkus.azure.services.version>1.2.5</quarkus.azure.services.version>

    <rewrite-maven-plugin.version>6.46.1</rewrite-maven-plugin.version>
    <rewrite-migrate-java.version>3.42.1</rewrite-migrate-java.version>
    <rewrite-static-analysis.version>2.41.1</rewrite-static-analysis.version>
    <rewrite-testing-frameworks.version>3.44.0</rewrite-testing-frameworks.version>

    <spotless-maven-plugin.version>3.10.4</spotless-maven-plugin.version>
    <versions-maven-plugin.version>2.23.0</versions-maven-plugin.version>
    <maven-sonar-plugin.version>5.8.0.7211</maven-sonar-plugin.version>
    <spotbugs-annotations.version>4.10.5</spotbugs-annotations.version>

    <!-- Sonar and Jacoco Interaction (unit test coverage checks) -->
    <sonar.java.coveragePlugin>jacoco</sonar.java.coveragePlugin>
    <sonar.dynamicAnalysis>reuseReports</sonar.dynamicAnalysis>
    <sonar.language>java</sonar.language>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.quarkiverse.azureservices</groupId>
        <artifactId>quarkus-azure-services-bom</artifactId>
        <version>${quarkus.azure.services.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>${guava.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>failureaccess</artifactId>
        <version>${google.failureaccess.version}</version>
      </dependency>
      <dependency>
        <groupId>jakarta.inject</groupId>
        <artifactId>jakarta.inject-api</artifactId>
        <version>${jakarta.inject-api.version}</version>
      </dependency>
      <dependency>
        <groupId>jakarta.annotation</groupId>
        <artifactId>jakarta.annotation-api</artifactId>
        <version>${jakarta.annotation-api.version}</version>
      </dependency>
      <dependency>
        <groupId>commons-net</groupId>
        <artifactId>commons-net</artifactId>
        <version>${commons-net.version}</version>
      </dependency>
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>org.osgi.annotation.bundle</artifactId>
        <version>${osgi-annotation-bundle.version}</version>
      </dependency>
      <dependency>
        <groupId>com.azure</groupId>
        <artifactId>azure-identity</artifactId>
        <version>${azure-identity.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-annotations</artifactId>
        <version>${spotbugs-annotations.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.datatype</groupId>
        <artifactId>jackson-datatype-jsr310</artifactId>
        <version>${jackson-datatype.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-annotations</artifactId>
        <version>${jackson-annotations.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj-core.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.annotation.bundle</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <repositories>
    <!-- Put the repositories where the artifacts are actually stored (see settings.xml for proxies) -->
    <repository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>central</id>
      <name>Central Repository</name>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>central</id>
      <name>Central Repository</name>
      <url>https://repo.maven.apache.org/maven2</url>
    </pluginRepository>
  </pluginRepositories>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>io.quarkus</groupId>
          <artifactId>quarkus-maven-plugin</artifactId>
          <version>${quarkus.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${maven-dependency-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-release-plugin</artifactId>
          <version>${maven-release-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>${maven-site-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <showWarnings>true</showWarnings>
          <compilerArgs>
            <!-- We turn off:
                - `serial` because we don't use Java serialization
                  (and all it does is complain about the serialVersionUID)
            -->
            <arg>-Xlint:all,-serial</arg>
          </compilerArgs>
          <annotationProcessorPaths/>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>versions-maven-plugin</artifactId>
        <version>${versions-maven-plugin.version}</version>
        <configuration>
          <includeParent>false</includeParent>
          <generateBackupPoms>false</generateBackupPoms>
          <ignoredVersions>
            <ignoreVersion type="regex">.*-beta.*</ignoreVersion>
            <ignoreVersion type="regex">(?i).*Alpha(?:-?\d+)?</ignoreVersion>
            <ignoreVersion type="regex">(?i).*Beta(?:-?\d+)?</ignoreVersion>
            <ignoreVersion type="regex">(?i).*-[bB](?:-?[\d.]+)?</ignoreVersion>
            <ignoreVersion type="regex">(?i).*RC(?:-|\.?\d+)?</ignoreVersion>
            <ignoreVersion type="regex">(?i).*CR(?:-?\d+)?</ignoreVersion>
            <ignoreVersion type="regex">(?i).*MR?(?:-?\d+)?</ignoreVersion>
            <ignoreVersion type="regex">(?i).*redhat(?:-?\d+)?</ignoreVersion>
          </ignoredVersions>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <quarkus.log.level>FATAL</quarkus.log.level>
            <junit.jupiter.execution.parallel.enabled>true</junit.jupiter.execution.parallel.enabled>
            <junit.jupiter.execution.parallel.mode.default>concurrent</junit.jupiter.execution.parallel.mode.default>
            <junit.jupiter.execution.parallel.mode.classes.default>concurrent</junit.jupiter.execution.parallel.mode.classes.default>
            <junit.jupiter.execution.timeout.test.method.default>${junit.timeout}</junit.jupiter.execution.timeout.test.method.default>
            <junit.jupiter.execution.timeout.thread.mode.default>same_thread</junit.jupiter.execution.timeout.thread.mode.default>
          </systemPropertyVariables>
          <argLine>@{argLine} --add-opens java.base/java.lang=ALL-UNNAMED -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>${maven-source-plugin.version}</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openrewrite.maven</groupId>
        <artifactId>rewrite-maven-plugin</artifactId>
        <version>${rewrite-maven-plugin.version}</version>
        <configuration>
          <activeRecipes>
            <recipe>com.amadeus.aud</recipe>
          </activeRecipes>
          <configLocation>${maven.multiModuleProjectDirectory}/rewrite.yaml</configLocation>
          <failOnDryRunResults>true</failOnDryRunResults>
          <exclusions>
            <exclusion>*.yaml</exclusion>
            <!--        A bug seems to exist that prevents the correct translation of the path.
                        As a result we have to put **/deployment/** in the exclusion list, any other forms seems not working.
                        This means that if a submodule contains a deployment folder, it will not be processed by the rewrite plugin.
                        See: https://github.com/openrewrite/rewrite-maven-plugin/issues/801 -->
            <exclusion>**/deployment/**</exclusion>
            <exclusion>**/.idea/**</exclusion>
            <exclusion>**/.mvn/**</exclusion>
            <exclusion>**/target/**</exclusion>
            <exclude>${project.basedir}/docs/**</exclude>
            <exclusion>**/*.txt</exclusion>
            <exclusion>**/*.json</exclusion>
            <exclusion>**/*.proto</exclusion>
          </exclusions>
          <sizeThresholdMb>3</sizeThresholdMb>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.openrewrite.recipe</groupId>
            <artifactId>rewrite-static-analysis</artifactId>
            <version>${rewrite-static-analysis.version}</version>
          </dependency>
          <dependency>
            <groupId>org.openrewrite.recipe</groupId>
            <artifactId>rewrite-testing-frameworks</artifactId>
            <version>${rewrite-testing-frameworks.version}</version>
          </dependency>
          <dependency>
            <groupId>org.openrewrite.recipe</groupId>
            <artifactId>rewrite-migrate-java</artifactId>
            <version>${rewrite-migrate-java.version}</version>
          </dependency>
        </dependencies>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-maven-plugin.version}</version>
        <configuration>
          <lineEndings>UNIX</lineEndings>
          <!-- define a language-specific format -->
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
              <include>scripts/*.java</include>
            </includes>
            <!-- apply a specific flavor of google-java-format -->
            <googleJavaFormat>
              <version>1.36.1</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
            <removeUnusedImports>
              <engine>google-java-format</engine>
            </removeUnusedImports>
            <forbidWildcardImports/>
            <replaceRegex>
              <name>Remove @NonNull annotations. See ADR-004.</name>
              <searchRegex>@.*Non[Nn]ull</searchRegex>
              <replacement/>
            </replaceRegex>
            <replaceRegex>
              <name>Remove jupiter assertions. Use assertj assertions. See ADR-010.</name>
              <searchRegex>import org\.junit\.jupiter\.api\.Assertions</searchRegex>
              <replacement/>
            </replaceRegex>
            <replaceRegex>
              <name>Remove mockito.lenient. See ADR-010.</name>
              <searchRegex>import org\.mockito\.Mockito\.lenient</searchRegex>
              <replacement/>
            </replaceRegex>
          </java>
          <pom>
            <sortPom>
              <encoding>UTF-8</encoding>
              <lineSeparator>\n</lineSeparator>
            </sortPom>
          </pom>
          <markdown>
            <includes>
              <include>services/**/*.md</include>
              <include>docs/**/*.md</include>
              <include>README.md</include>
              <include>AGENTS.md</include>
            </includes>
            <flexmark>
              <formatterOptions>
                <rightMargin>120</rightMargin>
              </formatterOptions>
            </flexmark>
          </markdown>
          <json>
            <excludes>
              <!-- patterns are relative to each module: also covers child modules' build output -->
              <exclude>**/target/**</exclude>
              <exclude>**/.devcontainer/devcontainer.json</exclude>
            </excludes>
            <includes>
              <include>**/*.json</include>
            </includes>
            <gson>
              <indentSpaces>2</indentSpaces>
              <sortByKeys>false</sortByKeys>
              <escapeHtml>false</escapeHtml>
              <version>2.14.0</version>
            </gson>
          </json>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <phase>process-test-classes</phase>
            <configuration>
              <append>false</append>
              <includes>
                <include>com.amadeus.aud.*</include>
              </includes>
              <excludes>
                <exclude>*Test*</exclude>
              </excludes>
            </configuration>
          </execution>
          <execution>
            <id>check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>test</phase>
            <configuration>
              <rules>
                <rule implementation="org.jacoco.maven.RuleConfiguration">
                  <element>BUNDLE</element>
                  <limits>
                    <limit implementation="org.jacoco.report.check.Limit">
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${unittests.instruction.coverage}</minimum>
                    </limit>
                    <limit implementation="org.jacoco.report.check.Limit">
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${unittests.branch.coverage}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
              <excludes>
                <exclude>com/amadeus/aud/services/engine/rule/gprc/*</exclude>
              </excludes>
            </configuration>
          </execution>
          <execution>
            <id>report</id>
            <goals>
              <goal>report</goal>
            </goals>
            <phase>prepare-package</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.version}</version>
      </plugin>
      <plugin>
        <groupId>org.sonarsource.scanner.maven</groupId>
        <artifactId>sonar-maven-plugin</artifactId>
        <version>${maven-sonar-plugin.version}</version>
      </plugin>
    </plugins>
  </build>
</project>
