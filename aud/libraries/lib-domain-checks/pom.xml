<?xml version="1.0" encoding="UTF-8"?>
<project>
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.amadeus.aud</groupId>
    <artifactId>libraries</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <groupId>com.amadeus.aud.libraries</groupId>
  <artifactId>lib-domain-checks</artifactId>
  <inceptionYear>2025</inceptionYear>

  <properties>
    <!-- Keep to java 21 as long as python image is using jvm 21 -->
    <maven.compiler.release>21</maven.compiler.release>
    <unittests.instruction.coverage>0.99</unittests.instruction.coverage>
    <unittests.branch.coverage>0.99</unittests.branch.coverage>

    <annotations.version>4.10.5</annotations.version>
    <hibernate-validator.version>9.1.5.Final</hibernate-validator.version>
    <jakarta-el.version>6.0.0</jakarta-el.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.github.spotbugs</groupId>
      <artifactId>spotbugs-annotations</artifactId>
      <version>${annotations.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>

    <dependency>
      <groupId>org.hibernate.validator</groupId>
      <artifactId>hibernate-validator</artifactId>
      <version>${hibernate-validator.version}</version>
    </dependency>
    <dependency>
      <groupId>org.glassfish.expressly</groupId>
      <artifactId>expressly</artifactId>
      <version>${jakarta-el.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.amadeus.aud.libraries</groupId>
      <artifactId>lib-yaml-model</artifactId>
      <version>${project.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.amadeus.aud.libraries</groupId>
      <artifactId>lib-checker-api</artifactId>
      <version>${project.version}</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- Jandex index needed so that Quarkus discovers the checks -->
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
        <version>${jandex-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>make-index</id>
            <goals>
              <goal>jandex</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
